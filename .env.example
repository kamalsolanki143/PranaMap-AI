# ==============================================================================
# PranaMap AI - Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Cloud & Google AI Services (Hackathon Core Stack)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=pranamap-ai-clean-air
FIREBASE_PROJECT_ID=pranamap-ai-clean-air
FIREBASE_SERVICE_ACCOUNT_JSON=./credentials/firebase-service-account.json

# ------------------------------------------------------------------------------
# Backend Service Configuration (FastAPI)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=pranamap-secure-key-replace-in-prod
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Next.js - Only NEXT_PUBLIC_ is exposed)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAP_STYLE=https://demotiles.maplibre.org/style.json

# Optional Firebase Client Credentials
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pranamap-ai-clean-air.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pranamap-ai-clean-air
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=pranamap-ai-clean-air.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# External Telemetry Data Providers (Optional - deterministic fallbacks active)
# ------------------------------------------------------------------------------
NASA_FIRMS_API_KEY=
OPENWEATHER_API_KEY=
SENTINEL_HUB_API_KEY=
DATA_PROVIDER_API_KEY=
